[flake8]
max-line-length = 200
max-complexity = 15
ignore = E203, E266, E501, W503, F403, F401, E402, E305, W291, W292, E111, E117, E114, E302, W293, F541, W391, E261, E126, E131, F841, E303
exclude =
    .git,
    __pycache__,
    docs/source/conf.py,
    old,
    build,
    dist,
    .venv,
    venv,
    env,
    .env,
    migrations
